LOG_LEVEL=INFO
LOG_FORMAT=json
# fake (tests only), openrouter, or ollama (a local model, free; install https://ollama.com)
LLM_PROVIDER=fake
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# For ollama: run `ollama pull qwen2.5-coder:7b`; inside Docker the backend reaches it at host.docker.internal
OLLAMA_MODEL=qwen2.5-coder:7b
# 20 is enough for OpenRouter; use 60 for a local model
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=512
LLM_TOKEN_BUDGET=50000
JWT_SECRET=