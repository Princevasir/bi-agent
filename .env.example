LOG_LEVEL=INFO
LOG_FORMAT=json
# Which model writes the SQL: ollama (local, free; install https://ollama.com), groq, openrouter, or fake (tests only).
# scripts/setup.sh pulls the Ollama models; inside Docker the backend reaches Ollama at host.docker.internal.
LLM_PROVIDER=ollama
# Optional fast mode: LLM_PROVIDER=groq with LLM_FALLBACK_PROVIDER=ollama. Groq answers in about 2 seconds;
# when it fails or hits its rate limit (free tier: about one retail question a minute), Ollama answers instead.
LLM_FALLBACK_PROVIDER=
OLLAMA_MODEL=qwen2.5-coder:7b
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# The local model needs time: 120 seconds per call; 20 is enough for a hosted model
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=512
# Tokens per hour (rolling), in total and per user; the budget refills on its own
LLM_TOKEN_BUDGET=400000
LLM_USER_TOKEN_BUDGET=150000
# retail: the generated Trailhead Outfitters data (29 tables) with business knowledge; sample: the 12-row test data
DATA_SOURCE=retail
# Left empty here; scripts/setup.sh (or scripts/prepare_env.py) generates one in .env. Never commit .env.
JWT_SECRET=
